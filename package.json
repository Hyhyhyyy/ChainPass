{
  "name": "chainpass",
  "version": "2.0.0",
  "private": true,
  "description": "跨境数字身份、可解释合规决策与内部多币种账本原型",
  "keywords": ["digital-identity", "verifiable-credentials", "vue3", "spring-boot"],
  "author": "ChainPass Team",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @chainpass/web dev",
    "dev:server": "mvn -f apps/server/pom.xml spring-boot:run",
    "build": "pnpm --filter @chainpass/web build",
    "build:server": "mvn -f apps/server/pom.xml package",
    "test": "pnpm --filter @chainpass/web test --run --passWithNoTests && mvn -f apps/server/pom.xml test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:build": "docker-compose -f docker/docker-compose.yml build"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "~5.8.0"
  }
}
